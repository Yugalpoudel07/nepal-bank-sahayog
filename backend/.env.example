# Copy to backend/.env and fill in. Never commit the real .env.

# Runtime LLM (Gemini via langchain-google-genai) — free key from https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# One-time chunk enrichment — FREE options (no billing account needed):
#   none   = deterministic heuristics + bilingual glossary only (default; the NRB corpus has ~7,300 chunks)
#   gemini = Gemini API free tier, same GOOGLE_API_KEY as above (do NOT link billing to that project);
#            takes several days of free daily quota for the whole corpus, resumes automatically
#   ollama = local open model via https://ollama.com (fully offline, slow on CPU)
ENRICH_PROVIDER=none
ENRICH_GEMINI_MODEL=gemini-3.5-flash-lite
ENRICH_REQUESTS_PER_MINUTE=10
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional, PAID alternative (leave empty to never use it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Multilingual embeddings (Nepali + English). "hashing" = tests/offline only.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# EMBEDDING_QUERY_PREFIX=query:      # set automatically for e5 models
# EMBEDDING_PASSAGE_PREFIX=passage:

# Retrieval tuning
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
TOP_K=6
# Rulebook preferred when a question names no institution type: abc = class A/B/C banks ("" = none)
DEFAULT_FAMILY=abc
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# HTTP
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30
MAX_MESSAGE_CHARS=2000
LOG_LEVEL=INFO
AUTO_REBUILD_INDEX=true

# Windows: path to tesseract.exe if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
